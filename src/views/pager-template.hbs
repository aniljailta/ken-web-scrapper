<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
    <script src='https://cdn.tailwindcss.com'></script>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap'
      rel='stylesheet'
    />
    <style>
      body { font-family: "Inter", sans-serif; }
    </style>

    <style>
      :root {
      {{#if primaryColor}}
        --primary:
        {{primaryColor}};
      {{else}}
        --primary: #4976FF;
      {{/if}}

      {{#if secondaryColor}}
        --secondary:
        {{secondaryColor}};
      {{else}}
        --secondary: #22559F;
      {{/if}}
      } .primary_bg { background-color: var(--primary); } .primary_quote {
      color: var(--primary); } .primary_text { color:
      {{primaryTextColor}}; } .primary_outline { outline-color: var(--primary);
      } .secondary_bg { background-color: var(--secondary); } .secondary_text {
      color:
      {{secondaryTextColor}}; } .secondary_border { border-color:
      var(--secondary); } .secondary_highlight { color: var(--secondary); }
      strong { font-weight: 700 !important; position: relative; }
    </style>
  </head>
  <body class='h-full w-full'>
    <header
      class='w-full bg-white max-h-[88px] h-[62px] py-3 flex items-center justify-center'
    >
      {{#if logo}}
        <div class='max-h-36 flex justify-start items-center gap-3'>
          <img class='w-52 h-[38px] object-contain' src='{{logo}}' />
        </div>
      {{/if}}
    </header>
    <main class='w-full h-auto'>
      <section
        class='py-5 w-full flex items-center justify-center flex-col gap-3.5 px-10 h-[196px]'
      >
        <!-- Main Heading -->
        <h2
          class="text-black text-2xl font-normal font-['Inter'] leading-7 max-w-[476px] text-center"
        >
          {{stripPTags title}}
        </h2>
        <!-- Sub Heading -->
        <p
          class="text-center text-xs font-light font-['Inter'] leading-[18px] max-w-[440px]"
        >
          {{stripPTags subTitle}}
        </p>
      </section>
      <!-- The Problem / Solution Section -->
      <section
        class='w-full flex items-start justify-between gap-[21px] px-[24px] py-[24px] bg-slate-200 mt-[8px] h-[212px]'
      >
        <!-- The Problem Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Problem</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-[12px] font-light leading-[18px] font-['Inter'] w-[239px] tracking-[-0.1px] !my-0"
            >
              {{stripPTags problem}}
            </p>
          </div>
        </div>

        <!-- The Solution Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Solution</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-[12px] font-light leading-[18px] w-[236px] font-['Inter'] tracking-[-0.1px] !my-0"
            >
              {{stripPTags solution}}
            </p>
          </div>
        </div>
      </section>
      <!-- Highlights -->

      <section
        class='w-full flex items-center flex-col justify-center gap-0 py-[20px]'
      >
        <div
          class='flex flex-col items-start justify-start gap-[14px] w-full pt-[5px] px-[44px]'
        >
          {{#each (limit highlights 3)}}
            <!-- Highlight Card -->
            <div
              class='flex flex-row justify-start items-start h-auto flex-1 w-full gap-[25px]'
            >
              <!-- Count -->
              <div
                class="rounded-full border border-[1px] secondary_border secondary_highlight font-['Inter'] text-base font-light leading-tight min-w-[24px] min-h-[24px] text-center flex items-center justify-center"
              >
                {{inc @index}}
              </div>
              <!-- Description -->
              <div
                class="flex items-start justify-start flex-col p-0 m-0 w-full font-['Inter'] text-[12px] leading-[18px] font-light text-start w-[474px]"
              >
                <p class='w-[474px]'>
                  {{stripPTags this}}
                </p>
              </div>
            </div>
          {{/each}}
        </div>
      </section>
      <footer
        class='pl-[56px] pr-[56px] py-6 secondary_bg flex flex-col items-center justify-center gap-5 fixed bottom-0 w-full h-[104px]'
      >
        <p
          class="text-[16px] font-[500] secondary_text font-['Inter'] leading-tight text-center"
        >
          {{cta}}
        </p>
        <a
          class='primary_bg rounded-[36px] primary_text w-auto h-auto py-1 flex items-center justify-center px-4'
          role='link'
          target='_blank'
          href='{{ctaLink}}'
        >
          {{ctaText}}
        </a>
      </footer>
    </main>
  </body>
</html>