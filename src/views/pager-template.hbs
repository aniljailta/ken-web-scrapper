<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>
      {{stripPTags title}}
    </title>
    <script src='https://cdn.tailwindcss.com'></script>
    <!-- Preload font files -->
    <link
      rel='preload'
      href='https://rightpage.io/scraper-api/fonts/Inter-Light.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='https://rightpage.io/scraper-api/fonts/Inter-Regular.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href='https://rightpage.io/scraper-api/fonts/Inter-Bold.woff2'
      as='font'
      type='font/woff2'
      crossorigin='anonymous'
    />
    <link
      rel='stylesheet'
      href='https://rightpage.io/scraper-api/fonts/inter.css'
    />

    <style>
      /* CSS */ :root { font-family: Inter, sans-serif; font-feature-settings:
      'liga' 1, 'calt' 1; /* fix for Chrome */ } @supports
      (font-variation-settings: normal) { :root { font-family: InterVariable,
      sans-serif; } }
    </style>

    <style>
      :root {
      {{#if primaryColor}}
        --primary:
        {{primaryColor}};
      {{else}}
        --primary: #4976FF;
      {{/if}}

      {{#if secondaryColor}}
        --secondary:
        {{secondaryColor}};
      {{else}}
        --secondary: #22559F;
      {{/if}}
      } .primary_bg { background-color: var(--primary); } .primary_quote {
      color: var(--primary); } .primary_text { color:
      {{primaryTextColor}}; } .primary_outline { outline-color: var(--primary);
      } .secondary_bg { background-color: var(--secondary); } .secondary_text {
      color:
      {{secondaryTextColor}}; } .secondary_border { border-color:
      var(--secondary); } .secondary_highlight { color: var(--secondary); }
      strong { font-weight: 700 !important; position: relative; } body {
      letter-spacing: 0; }
    </style>
  </head>
  <body class='h-full w-full'>
    <header
      class='w-full bg-white max-h-[88px] h-[62px] flex items-center justify-center gap-[16px]'
    >
      {{#if logo}}
        <div
          class='h-[62px] max-h-[70px] h-full flex justify-start items-center pt-[15px] gap-3'
        >
          <img class='h-[38px] object-contain' src='{{logo}}' />
        </div>
      {{/if}}
    </header>
    <main class='w-full h-auto mt-[4px]'>
      <section
        class='py-5 w-full flex items-center justify-center flex-col gap-3.5 px-10 h-[171px]'
      >
        <!-- Main Heading -->
        <h2
          class="text-black text-[24px] font-medium font-['Inter'] leading-[28.8px] max-w-[476px] text-center"
        >
          {{stripPTags title}}
        </h2>
        <!-- Sub Heading -->
        <p
          class="text-center text-[12px] font-[300] leading-[18px] font-['Inter'] leading-[18px] max-w-[440px]"
        >
          {{stripPTags subTitle}}
        </p>
      </section>
      <!-- The Problem / Solution Section -->
      <section
        style='background-color: #fff;'
        class='w-full flex items-start justify-between gap-[21px] px-[24px] py-[24px] mt-[8px] h-[200px]'
      >
        <!-- The Problem Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Problem</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-[12px] font-light leading-[18px] font-['Inter'] w-[239px] tracking-[0px] !my-0"
            >
              {{stripPTags problem}}
            </p>
          </div>
        </div>

        <!-- The Solution Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Solution</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-[12px] font-light leading-[18px] w-[236px] font-['Inter'] tracking-[0px] !my-0"
            >
              {{stripPTags solution}}
            </p>
          </div>
        </div>
      </section>
      <!-- Highlights -->

      <section
        class='w-full flex items-center flex-col justify-center gap-0 py-[5px] h-[220px]'
      >
        <div
          class='flex flex-col items-start justify-start gap-[14px] w-full pt-[5px] px-[44px] h-full'
        >
          {{#each (limit highlights 3)}}
            <!-- Highlight Card -->
            <div
              class='flex flex-row justify-start items-start h-auto flex-1 w-full gap-[25px]'
            >
              <!-- Count -->
              <div
                class="rounded-full border border-[1px] border-[#000] text-black font-['Inter'] text-base font-light leading-tight min-w-[24px] min-h-[24px] text-center flex items-center justify-center"
              >
                {{inc @index}}
              </div>
              <!-- Description -->
              <div
                class="flex items-start justify-start flex-col p-0 m-0 w-full font-['Inter'] text-[12px] leading-[18px] font-light text-start w-[474px]"
              >
                <p class='w-[474px]'>
                  {{stripPTags this}}
                </p>
              </div>
            </div>
          {{/each}}
        </div>
      </section>
      <footer
        class='pl-[56px] pr-[56px] py-6 bg-white flex flex-col items-center justify-end gap-5 fixed bottom-0 w-full h-[134px]'
      >
        <p
          class="text-[16px] font-[500] text-black font-['Inter'] leading-tight text-center"
        >
          {{stripPTags cta}}
        </p>
        <a
          class='bg-black rounded-[36px] text-white w-auto h-auto py-1 flex items-center justify-center px-4'
          role='link'
          target='_blank'
          href='{{ctaLink}}'
        >
          {{ctaText}}
        </a>
      </footer>
    </main>
  </body>
</html>