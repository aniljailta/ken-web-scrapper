<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
    <script src='https://cdn.tailwindcss.com'></script>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap'
      rel='stylesheet'
    />

    <style>
      :root {
      {{#if primaryColor}}
        --primary:
        {{primaryColor}};
      {{else}}
        --primary: #4976FF;
      {{/if}}

      {{#if secondaryColor}}
        --secondary:
        {{secondaryColor}};
      {{else}}
        --secondary: #22559F;
      {{/if}}
      } .primary_bg { background-color: var(--primary); } .primary_quote {
      color: var(--primary); } .primary_text { color:
      {{primaryTextColor}}; } .primary_outline { outline-color: var(--primary);
      } .secondary_bg { background-color: var(--secondary); } .secondary_text {
      color:
      {{secondaryTextColor}}; } .secondary_border { border-color:
      var(--secondary); } .secondary_highlight { color: var(--secondary); } p
      strong { font-weight: 700 !important; }
    </style>
  </head>
  <body class='h-full w-full'>
    <header
      class='w-full bg-white max-h-[88px] py-3 flex items-center justify-center'
    >
      {{#if logo}}
        <div class='max-h-36 flex justify-start items-center gap-3'>
          <img class='w-52 h-16 object-contain' src='{{logo}}' />
        </div>
      {{/if}}
    </header>
    <main class='w-full h-auto'>
      <section
        class='py-5 w-full flex items-center justify-center flex-col gap-3.5 px-10'
      >
        <!-- Main Heading -->
        <h2
          class='text-black text-2xl font-normal font-[Inter] leading-7 max-w-[476px] text-center'
        >
          {{stripPTags title}}
        </h2>
        <!-- Sub Heading -->
        <p
          class='text-center text-xs font-light font-[Inter] leading-[18px] max-w-[440px]'
        >
          {{stripPTags subTitle}}
        </p>
      </section>
      <!-- The Problem / Solution Section -->
      <section
        class='w-full flex items-start justify-between gap-[21px] px-[24px] py-[24px] bg-[#E9EEF5] mt-[8px]'
      >
        <!-- The Problem Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Problem</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-xs font-light leading-[18px] font-['Inter'] !my-0"
            >
              {{stripPTags problem}}
            </p>
          </div>
        </div>

        <!-- The Solution Card -->
        <div
          class='flex flex-col items-start justify-start gap-[11px] h-auto flex-1'
        >
          <span
            class="font-['Inter'] text-base text-black leading-5 font-medium ml-[20px]"
          >The Solution</span>
          <div
            class='rounded flex items-start justify-center min-h-full px-[20px]'
          >
            <p
              class="text-left text-xs font-light leading-[18px] font-['Inter'] !my-0"
            >
              {{stripPTags solution}}
            </p>
          </div>
        </div>
      </section>
      <!-- Highlights -->

      <section
        class='w-full flex items-start justify-center gap-[37px] px-[44px] mt-10 mb-10'
      >
        {{#each (limit highlights 3)}}
          <!-- Highlight Card -->
          <div
            class='flex flex-col justify-start items-center h-[162px] flex-1 w-[150px] gap-2.5'
          >
            <!-- Count -->
            <div
              class='rounded-full border border-[1px] secondary_border secondary_highlight font-[Inter] text-base font-light leading-tight w-6 h-6 text-center flex items-center justify-center'
            >
              {{inc @index}}
            </div>
            <!-- Description -->
            <p class='font-[Inter] text-xs font-normal text-center'>
              {{stripPTags this}}
            </p>
          </div>
        {{/each}}
      </section>
      <footer
        class='px-10 py-6 secondary_bg flex flex-col items-center justify-center gap-5 fixed bottom-0 w-full'
      >
        <p
          class='text-base font-normal secondary_text font-[Inter] leading-tight text-center'
        >
          {{cta}}
        </p>
        <a
          class='primary_bg rounded-[36px] primary_text w-auto h-auto py-1 flex items-center justify-center px-4'
          role='link'
          target='_blank'
          href='{{ctaLink}}'
        >
          {{ctaText}}
        </a>
      </footer>
    </main>
  </body>
</html>